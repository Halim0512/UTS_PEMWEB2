{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "es2019",

    "module": "Node16",
    "moduleResolution": "Node16",

    "lib": ["es2019"],

    "types": ["node"],

    "esModuleInterop": true,

    "strict": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}